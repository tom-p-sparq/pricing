{
  "scripts": {
    "build": "esbuild index.js --bundle --format=esm --outfile=bundle.js",
    "watch": "esbuild index.js --bundle --format=esm --outfile=bundle.js --watch",
    "serve": "http-server ../pages --cors -c-1",
    "dev": "npm-run-all --parallel watch serve"
  },
  "dependencies": {
    "@observablehq/inputs": "^0.10.6",
    "@observablehq/plot": "^0.6.13",
    "@observablehq/runtime": "^6.0.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "esbuild": "^0.27.2",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5"
  }
}
